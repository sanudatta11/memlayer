---
import { LinkButton } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

{/* Pin holding state before paint so copy doesn't flash. */}
<script is:inline>
	document.documentElement.dataset.mlHero = 'holding';
</script>

<section class="ml-hero" aria-labelledby={PAGE_TITLE_ID} data-ml-hero data-state="holding">
	<div class="ml-hero__curtain" aria-hidden="true" data-ml-curtain>
		<div class="ml-hero__shard ml-hero__shard--left">
			<img
				src="/banner.jpg"
				alt=""
				width="1920"
				height="1081"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
		<div class="ml-hero__shard ml-hero__shard--right">
			<img
				src="/banner.jpg"
				alt=""
				width="1920"
				height="1081"
				decoding="async"
				fetchpriority="high"
			/>
		</div>
	</div>

	<div class="ml-hero__copy" data-ml-copy>
		<h1 id={PAGE_TITLE_ID} class="ml-hero__wordmark" data-page-title>{title}</h1>
		{tagline && <p class="ml-hero__tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="ml-hero__actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
		<div class="ml-hero__core">
			<span class="ml-hero__core-label">local · on disk</span>
			<pre><code>git clone https://github.com/sanudatta11/memlayer && cd memlayer
make prereqs && make install
export PATH="$HOME/.local/bin:$PATH"
memlayer --version</code></pre>
			<p class="ml-hero__note">
				Per-project SQLite under <code>~/.memlayer/</code>. A thin CLI talks to a local daemon;
				agents reach it through MCP or shell hooks.
			</p>
		</div>
	</div>
</section>

<script>
	function finishCurtain(curtain: Element | null) {
		if (!(curtain instanceof HTMLElement)) return;
		const drop = () => curtain.remove();
		curtain.addEventListener('transitionend', drop, { once: true });
		window.setTimeout(drop, 1100);
	}

	function runHeroIntro() {
		const hero = document.querySelector('[data-ml-hero]');
		if (!(hero instanceof HTMLElement)) return;

		const curtain = hero.querySelector('[data-ml-curtain]');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const reveal = () => {
			hero.dataset.state = 'revealed';
			document.documentElement.dataset.mlHero = 'revealed';
			finishCurtain(curtain);
		};

		if (reduce) {
			reveal();
			return;
		}

		// Short hold on the banner, then split and fly.
		window.setTimeout(() => {
			hero.dataset.state = 'parting';
			document.documentElement.dataset.mlHero = 'parting';
			// Home content fades in while shards leave.
			window.setTimeout(reveal, 450);
		}, 650);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', runHeroIntro, { once: true });
	} else {
		runHeroIntro();
	}
</script>
